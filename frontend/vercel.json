{
  "version": 2,
  "name": "medisync-frontend",
  "builds": [
    {
      "src": "**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://backend-production-f09f.up.railway.app/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://backend-production-f09f.up.railway.app/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
